# ── Database (required) ───────────────────────────────────────────────────────
# Supabase Postgres connection string. Use the AWS IPv4 pooler URL on cloud
# platforms (the direct host is IPv6-only). See README for setup.
DATABASE_URL=postgresql://postgres.xxx:xxx@aws-1-xxx.pooler.supabase.com:6543/postgres

# ── Auth (protects entire API) ────────────────────────────────────────────────
# The backend is deployed to a PUBLIC hostname, so this password is the only
# thing between the internet and the API. Every request must carry it as the
# X-Auth-Key header (or ?key=... for curl). Set a strong random value and add
# the SAME value to nextjs-app/.env.local as AUTH_KEY.
# Generate: openssl rand -base64 32
#
# If this is missing, empty, or left as the placeholder below, the API refuses
# every request (503). It will NOT fall back to serving anonymously.
AUTH_PASSWORD=change_me_to_a_strong_random_string

# LOCAL DEVELOPMENT ONLY. Set to 1 to run with no password at all.
# NEVER set this to 1 on Render or any deployed service — it disables
# authentication completely and publishes your API to the internet.
AUTH_DEV_MODE=0

# Brute-force throttle: failed auth attempts allowed per client IP before the
# API answers 429 for the rest of the window. Optional; shown values are the
# defaults.
# AUTH_FAIL_LIMIT=10
# AUTH_FAIL_WINDOW_S=300

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# ── LLM providers ─────────────────────────────────────────────────────────────
# Set at least one of the two. If both are set, LLM_PROVIDER picks which to use
# (default: anthropic if ANTHROPIC_API_KEY is set, else gemini).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Point the Anthropic SDK at any Anthropic-compatible endpoint (e.g. MiniMax proxy).
# Leave empty to use the official Anthropic API.
ANTHROPIC_BASE_URL=

# Model names. If you use the MiniMax proxy, set ANTHROPIC_MODEL=MiniMax-M2.7.
# Official Anthropic API defaults to claude-sonnet-4-5; Gemini to gemini-2.5-flash.
ANTHROPIC_MODEL=
GEMINI_MODEL=

# Override the default provider ("anthropic" or "gemini"). Can also be set per-request
# in the chat UI.
LLM_PROVIDER=

# ── Data sources (optional) ───────────────────────────────────────────────────
NEWSAPI_KEY=
ALPHA_VANTAGE_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
