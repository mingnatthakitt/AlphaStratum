# ── LLM providers ─────────────────────────────────────────────────────────────
# Set at least one of the two. If both are set, LLM_PROVIDER picks which to use
# (default: anthropic if ANTHROPIC_API_KEY is set, else gemini).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Point the Anthropic SDK at any Anthropic-compatible endpoint (e.g. MiniMax proxy).
# Leave empty to use the official Anthropic API.
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic

# Model name to use with the Anthropic SDK. Override to switch models without code changes.
ANTHROPIC_MODEL=MiniMax-M2.7

# Override the default provider ("anthropic" or "gemini"). Can also be set per-request
# in the chat UI.
LLM_PROVIDER=

# ── Data sources ──────────────────────────────────────────────────────────────
NEWSAPI_KEY=
ALPHA_VANTAGE_KEY=

# ── Auth (protects entire API) ──────────────────────────────────────────
# Every request to the API must include this password.
# Set a strong random value and add it to Next.js .env.local as NEXT_PUBLIC_AUTH_PASSWORD.
AUTH_PASSWORD=change_me_to_a_strong_random_string
