# Alpha Stratum — Environment Variables
# Copy this file to .env.local and fill in the values

# Backend URL (FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth key — must match AUTH_PASSWORD in fastapi-backend/.env
# IMPORTANT: do NOT prefix with NEXT_PUBLIC_ — it must stay server-only so the
# secret never ends up in the browser bundle. The Next.js proxy route
# (app/api/proxy/[...path]/route.ts) attaches it to every upstream request.
# Local dev: set it here. Vercel deploy: set it in Vercel env vars (server-side).
# Generate: openssl rand -base64 32
AUTH_KEY=your_secure_password_here
