# Alpha Stratum — Environment Variables
# Copy this file to .env.local and fill in the values

# Backend URL (FastAPI sidecar)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth key — must match AUTH_PASSWORD in fastapi-backend/.env
# IMPORTANT: do NOT prefix with NEXT_PUBLIC_ — keep server-only.
# For local dev: set in .env.local (Next.js reads non-NEXT_PUBLIC_ vars server-side only)
# For Vercel deploy: set in Vercel environment variables (Server-side)
# Generate: openssl rand -base64 32
NEXT_PUBLIC_AUTH_KEY=your_secure_password_here
